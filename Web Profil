<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Faris | Personal Portfolio</title>

    <meta name="description"
        content="Personal portfolio dan biodata Faris, student yang tertarik dengan teknologi dan web development.">

    <style>
        /* =====================================================
           RESET & GLOBAL
        ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        :root {
            --bg: #070b14;
            --bg-secondary: #0d1424;
            --card: rgba(16, 25, 43, 0.75);
            --text: #f5f7fb;
            --text-secondary: #aab4c5;
            --primary: #3b82f6;
            --primary-light: #60a5fa;
            --border: rgba(255,255,255,0.08);
            --shadow: 0 20px 50px rgba(0,0,0,0.25);
        }

        body.light {
            --bg: #f4f7fb;
            --bg-secondary: #ffffff;
            --card: rgba(255,255,255,0.85);
            --text: #111827;
            --text-secondary: #5b6472;
            --border: rgba(0,0,0,0.08);
            --shadow: 0 20px 50px rgba(30,50,80,0.12);
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background:
                radial-gradient(circle at 15% 20%, rgba(59,130,246,0.12), transparent 30%),
                radial-gradient(circle at 85% 80%, rgba(37,99,235,0.10), transparent 30%),
                var(--bg);
            color: var(--text);
            line-height: 1.6;
            transition: background 0.3s ease, color 0.3s ease;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        ul {
            list-style: none;
        }

        img {
            max-width: 100%;
            display: block;
        }

        .container {
            width: min(1100px, 90%);
            margin: auto;
        }

        section {
            padding: 100px 0;
        }

        .section-title {
            text-align: center;
            margin-bottom: 55px;
        }

        .section-title span {
            color: var(--primary-light);
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 3px;
        }

        .section-title h2 {
            font-size: clamp(30px, 5vw, 45px);
            margin-top: 8px;
        }

        .section-title p {
            max-width: 600px;
            margin: 12px auto 0;
            color: var(--text-secondary);
        }


        /* =====================================================
           NAVBAR
        ===================================================== */

        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(7,11,20,0.75);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid var(--border);
        }

        body.light header {
            background: rgba(255,255,255,0.75);
        }

        .navbar {
            height: 75px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 24px;
            font-weight: 800;
        }

        .logo span {
            color: var(--primary);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 30px;
        }

        .nav-links a {
            color: var(--text-secondary);
            font-size: 14px;
            font-weight: 600;
            transition: 0.3s;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: var(--primary-light);
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .theme-btn,
        .menu-btn {
            width: 40px;
            height: 40px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--card);
            color: var(--text);
            cursor: pointer;
            font-size: 18px;
        }

        .menu-btn {
            display: none;
        }


        /* =====================================================
           BUTTON
        ===================================================== */

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 13px 23px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 700;
            border: 1px solid transparent;
            cursor: pointer;
            transition: 0.3s;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
            box-shadow: 0 10px 25px rgba(59,130,246,0.25);
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            background: #2563eb;
        }

        .btn-outline {
            border-color: var(--border);
            color: var(--text);
            background: var(--card);
        }

        .btn-outline:hover {
            transform: translateY(-3px);
            border-color: var(--primary);
            color: var(--primary-light);
        }


        /* =====================================================
           HERO
        ===================================================== */

        #home {
            min-height: 100vh;
            display: flex;
            align-items: center;
            padding-top: 130px;
        }

        .hero {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            align-items: center;
            gap: 60px;
        }

        .hero-badge {
            display: inline-block;
            padding: 7px 14px;
            border: 1px solid rgba(59,130,246,0.3);
            background: rgba(59,130,246,0.08);
            border-radius: 30px;
            color: var(--primary-light);
            font-size: 13px;
            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: clamp(42px, 7vw, 76px);
            line-height: 1.05;
            margin-bottom: 15px;
        }

        .hero h1 span {
            color: var(--primary);
        }

        .typing {
            font-size: 22px;
            color: var(--primary-light);
            font-weight: 700;
            min-height: 35px;
        }

        .hero-description {
            max-width: 650px;
            margin: 20px 0 30px;
            color: var(--text-secondary);
            font-size: 17px;
        }

        .hero-buttons {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .socials {
            display: flex;
            gap: 12px;
            margin-top: 30px;
        }

        .socials a {
            width: 42px;
            height: 42px;
            border: 1px solid var(--border);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            transition: 0.3s;
        }

        .socials a:hover {
            color: white;
            background: var(--primary);
            transform: translateY(-4px);
        }

        .hero-image {
            display: flex;
            justify-content: center;
        }

        .profile-card {
            position: relative;
            width: min(330px, 80vw);
            height: 400px;
            border: 1px solid var(--border);
            background: linear-gradient(
                145deg,
                rgba(59,130,246,0.16),
                var(--card)
            );
            border-radius: 30px;
            box-shadow: var(--shadow);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .profile-circle {
            width: 190px;
            height: 190px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--primary), #1d4ed8);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 65px;
            font-weight: 800;
            color: white;
            box-shadow: 0 0 80px rgba(59,130,246,0.35);
        }

        .profile-card::before,
        .profile-card::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(96,165,250,0.2);
        }

        .profile-card::before {
            width: 280px;
            height: 280px;
        }

        .profile-card::after {
            width: 420px;
            height: 420px;
        }


        /* =====================================================
           ABOUT
        ===================================================== */

        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
        }

        .glass-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 30px;
            box-shadow: var(--shadow);
            backdrop-filter: blur(15px);
        }

        .about-text p {
            color: var(--text-secondary);
            margin-bottom: 15px;
        }

        .biodata {
            display: grid;
            gap: 12px;
        }

        .bio-item {
            display: flex;
            justify-content: space-between;
            gap: 15px;
            padding: 13px 0;
            border-bottom: 1px solid var(--border);
        }

        .bio-item:last-child {
            border-bottom: none;
        }

        .bio-item span:first-child {
            color: var(--text-secondary);
        }

        .bio-item span:last-child {
            text-align: right;
            font-weight: 600;
        }


        /* =====================================================
           SKILLS
        ===================================================== */

        .skills-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px;
        }

        .skill {
            margin-bottom: 23px;
        }

        .skill-info {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-weight: 600;
        }

        .skill-info span:last-child {
            color: var(--primary-light);
        }

        .skill-bar {
            height: 8px;
            background: rgba(255,255,255,0.08);
            border-radius: 10px;
            overflow: hidden;
        }

        body.light .skill-bar {
            background: rgba(0,0,0,0.08);
        }

        .skill-progress {
            width: 0;
            height: 100%;
            background: linear-gradient(
                90deg,
                var(--primary),
                var(--primary-light)
            );
            border-radius: 10px;
            transition: width 1.5s ease;
        }


        /* =====================================================
           PROJECT
        ===================================================== */

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 22px;
        }

        .project-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 18px;
            overflow: hidden;
            transition: 0.3s;
        }

        .project-card:hover {
            transform: translateY(-8px);
            border-color: rgba(59,130,246,0.4);
            box-shadow: var(--shadow);
        }

        .project-image {
            height: 170px;
            background:
                linear-gradient(
                    135deg,
                    rgba(59,130,246,0.35),
                    rgba(29,78,216,0.1)
                );
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 45px;
        }

        .project-content {
            padding: 22px;
        }

        .project-content h3 {
            margin-bottom: 8px;
        }

        .project-content p {
            color: var(--text-secondary);
            font-size: 14px;
            margin-bottom: 18px;
        }

        .project-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
            margin-bottom: 18px;
        }

        .project-tags span {
            padding: 5px 9px;
            border-radius: 6px;
            background: rgba(59,130,246,0.1);
            color: var(--primary-light);
            font-size: 11px;
        }


        /* =====================================================
           EDUCATION
        ===================================================== */

        .timeline {
            max-width: 800px;
            margin: auto;
            position: relative;
        }

        .timeline::before {
            content: "";
            position: absolute;
            left: 20px;
            top: 0;
            bottom: 0;
            width: 2px;
            background: var(--border);
        }

        .timeline-item {
            position: relative;
            padding-left: 65px;
            margin-bottom: 35px;
        }

        .timeline-dot {
            position: absolute;
            left: 10px;
            top: 4px;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: var(--primary);
            border: 5px solid var(--bg);
            box-shadow: 0 0 0 1px var(--primary);
        }

        .timeline-content {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 22px;
        }

        .timeline-content span {
            color: var(--primary-light);
            font-size: 13px;
            font-weight: 700;
        }

        .timeline-content h3 {
            margin: 5px 0;
        }

        .timeline-content p {
            color: var(--text-secondary);
        }


        /* =====================================================
           HOBBY
        ===================================================== */

        .hobby-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
        }

        .hobby-card {
            text-align: center;
            padding: 30px 20px;
            border: 1px solid var(--border);
            border-radius: 18px;
            background: var(--card);
            transition: 0.3s;
        }

        .hobby-card:hover {
            transform: translateY(-7px);
            border-color: var(--primary);
        }

        .hobby-icon {
            font-size: 35px;
            margin-bottom: 12px;
        }

        .hobby-card p {
            color: var(--text-secondary);
            font-size: 13px;
            margin-top: 5px;
        }


        /* =====================================================
           GOALS
        ===================================================== */

        .goal {
            max-width: 850px;
            margin: auto;
            text-align: center;
            padding: 55px 30px;
            border-radius: 25px;
            border: 1px solid rgba(59,130,246,0.25);
            background:
                radial-gradient(
                    circle at center,
                    rgba(59,130,246,0.12),
                    var(--card)
                );
        }

        .goal h2 {
            font-size: clamp(28px, 5vw, 42px);
            margin-bottom: 15px;
        }

        .goal p {
            color: var(--text-secondary);
            max-width: 650px;
            margin: auto;
        }


        /* =====================================================
           CONTACT
        ===================================================== */

        .contact-grid {
            display: grid;
            grid-template-columns: 0.8fr 1.2fr;
            gap: 25px;
        }

        .contact-info {
            display: grid;
            gap: 15px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 18px;
            border: 1px solid var(--border);
            border-radius: 14px;
            background: var(--card);
        }

        .contact-icon {
            width: 45px;
            height: 45px;
            border-radius: 10px;
            background: rgba(59,130,246,0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .contact-item p {
            color: var(--text-secondary);
            font-size: 13px;
        }

        .contact-form {
            display: grid;
            gap: 15px;
        }

        .form-group {
            display: grid;
            gap: 7px;
        }

        .form-group label {
            font-size: 13px;
            font-weight: 600;
        }

        input,
        textarea {
            width: 100%;
            padding: 14px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: var(--bg-secondary);
            color: var(--text);
            outline: none;
            font-family: inherit;
        }

        input:focus,
        textarea:focus {
            border-color: var(--primary);
        }

        textarea {
            resize: vertical;
            min-height: 130px;
        }


        /* =====================================================
           FOOTER
        ===================================================== */

        footer {
            border-top: 1px solid var(--border);
            padding: 30px 0;
            text-align: center;
            color: var(--text-secondary);
            font-size: 13px;
        }


        /* =====================================================
           MODAL
        ===================================================== */

        .modal {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.7);
            backdrop-filter: blur(8px);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            z-index: 2000;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            width: min(600px, 100%);
            background: var(--bg-secondary);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 30px;
            position: relative;
            animation: modalIn 0.3s ease;
        }

        @keyframes modalIn {
            from {
                opacity: 0;
                transform: scale(0.9);
            }

            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .modal-close {
            position: absolute;
            right: 20px;
            top: 15px;
            background: none;
            border: none;
            color: var(--text);
            font-size: 25px;
            cursor: pointer;
        }

        .modal-content p {
            color: var(--text-secondary);
            margin-top: 12px;
        }


        /* =====================================================
           BACK TO TOP
        ===================================================== */

        #backTop {
            position: fixed;
            right: 20px;
            bottom:
